# Allwinner bsp modules will fail to link if spinlock is inlined
# Set CONFIG_PREEMPT=y to select PREEMPTION, which disables inline spinlock
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT=y

# Allwinner bsp supplies CONFIG_AW_CPUFREQ_DT
# Regular CONFIG_CPUFREQ_DT will break boot
CONFIG_CPUFREQ_DT=n

# Allwinner has their own panfrost fork
CONFIG_DRM_PANFROST=n

# Mainline i2c camera modules collide with Allwinner VIN sensor modules
CONFIG_VIDEO_IMX214=n
CONFIG_VIDEO_IMX219=n

# Cubie A7S has an AIC8800D80 USB Wi-Fi/Bluetooth combo device.
# radxa.config disables the BSP driver in its final =n section; keep the
# override here so the USB loader, Wi-Fi, and Bluetooth modules are built.
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC8800_USB=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC_LOADFW_SUPPORT=m
CONFIG_AIC_BTUSB_SUPPORT=m
